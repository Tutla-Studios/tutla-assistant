generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  username        String?
  permissionLevel Int?      @default(0)

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

/// Bot-side profile for a Discord user (economy, premium, bans). Keyed by Discord user ID.
model DiscordUser {
  id        String    @id
  coins     Int       @default(0)
  xp        Int       @default(0)
  lastDaily DateTime?
  premium   Boolean   @default(false)
  banned    Boolean   @default(false)
  /// 0 user · 1 manage premium · 2 admin commands · 3 bot-ban users · 4 owner (logs, shell, edit)
  adminLevel    Int       @default(0)
  /// Set when the user accepts the Terms of Service prompt.
  tosAcceptedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("discord_user")
}

/// Channels subscribed to the Tutla feed (/subscribe).
model FeedSubscription {
  channelId String   @id
  guildId   String?
  createdAt DateTime @default(now())

  @@map("feed_subscription")
}

/// Small persisted key/value settings for the bot (e.g. the question of the day).
model BotSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("bot_setting")
}
